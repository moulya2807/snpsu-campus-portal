# ========================================================
# Sapthagiri NPS University (SNPSU) Portal Environment Config
# ========================================================

# Google AI Studio API Key (Get free key from https://aistudio.google.com)
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# Campus Coordinates Geofence (Chikkasandra Main Campus, Bengaluru)
EXPO_PUBLIC_CAMPUS_LAT=13.0645
EXPO_PUBLIC_CAMPUS_LNG=77.5028
EXPO_PUBLIC_CAMPUS_RADIUS_METERS=300

# Backend: Supabase or Firebase
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
